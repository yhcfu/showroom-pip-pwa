{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "showroom-pip-resolver",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173"
  },
  // Web Pushを使う場合は、D1作成後に次を有効化します。
