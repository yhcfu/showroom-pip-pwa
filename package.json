{
  "name": "showroom-pip-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:resolver": "wrangler dev --config worker/wrangler.jsonc",
    "build": "tsc --noEmit && tsc -p worker/tsconfig.json && vite build",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "deploy:resolver": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "hls.js": "^1.6.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.125.0"
  }
}
